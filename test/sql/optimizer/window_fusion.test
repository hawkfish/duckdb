# name: test/sql/optimizer/window_fusion.test
# description: Test basic window fusion rewrites
# group: [optimizer]

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
PRAGMA explain_output = PHYSICAL_ONLY;

# Streaming Windows should use fusion
query II
explain
SELECT id
FROM range(100) tbl(id)
QUALIFY row_number() OVER() = 1
----
physical_plan	<REGEX>:.*FILTER.*STREAMING_WINDOW.*Limit.*

query I
SELECT id
FROM range(100) tbl(id)
QUALIFY row_number() OVER() = 1
----
0

# Single Partitions should use fusion
query II
explain
SELECT id
FROM range(100) tbl(id)
QUALIFY row_number() OVER() = 1
----
physical_plan	<REGEX>:.*FILTER.*WINDOW.*Limit.*

query I
SELECT id
FROM range(100) tbl(id)
QUALIFY row_number() OVER(ORDER BY id DESC) = 1
----
99

# Single partitions with relatively high N should use truncation successfully
query II
explain
WITH q AS (
	SELECT id
	FROM range(10000) tbl(id)
	QUALIFY row_number() OVER(ORDER BY id DESC) < 700
)
SELECT min(id), max(id), count(*)
FROM q
----
physical_plan	<REGEX>:.*FILTER.*WINDOW.*Limit.*

query III
WITH q AS (
	SELECT id
	FROM range(100000) tbl(id)
	QUALIFY row_number() OVER(ORDER BY id DESC) < 6000
)
SELECT min(id), max(id), count(*)
FROM q
----
94001	99999	5999

